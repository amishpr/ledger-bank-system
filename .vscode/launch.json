{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API Server",
      "runtimeExecutable": "${workspaceFolder}/server/node_modules/.bin/tsx",
      "runtimeArgs": ["src/index.ts"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server Tests (all)",
      "program": "${workspaceFolder}/server/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "smartStep": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server Tests (current file)",
      "program": "${workspaceFolder}/server/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "smartStep": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Dashboard in Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web: dev"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (server + browser)",
      "configurations": ["Debug API Server", "Launch Dashboard in Chrome"],
      "stopAll": true
    }
  ]
}
